  ".deprecation-indexing-ilm-policy": {
    "_meta": {
      "description": "ILM policy used for deprecation logs",
      "managed": true
    },
    "phases": {
      "delete": {
        "actions": {
          "delete": {
            "delete_searchable_snapshot": true
