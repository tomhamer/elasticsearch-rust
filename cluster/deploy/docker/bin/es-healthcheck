#!/bin/bash
# Container healthcheck (the image's HEALTHCHECK and the compose services).
#
# With credentials or a CA configured (see es-http-lib: ES_URL, ES_CA_CERT,
# ES_PASSWORD[_FILE] / ELASTIC_PASSWORD): healthy when an authenticated,
# certificate-verified `GET /_cluster/health?local=true` answers 200.
#
# Otherwise (a bare `docker run` whose HTTPS certificate was generated by
# the node's security auto-configuration on first start): healthy when the
# node answers over HTTPS or HTTP, a 401 (authentication required)
# included, because the probe has no credentials.
set -uo pipefail
# shellcheck source=es-http-lib
. "$(dirname "$0")/es-http-lib"

path='/_cluster/health?local=true'
if [[ -n "${ES_CA_CERT:-}" || -n "$(es_password)" ]]; then
  code="$(es_curl -s -o /dev/null -w '%{http_code}' --max-time 4 "${ES_URL}${path}" || true)"
  [[ "$code" == 200 ]] && exit 0
  echo "unhealthy: ${ES_URL}${path} -> ${code}" >&2
  exit 1
fi

code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 2 "https://127.0.0.1:9200${path}" || true)"
if [[ "$code" == 000 ]]; then
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:9200${path}" || true)"
fi
case "$code" in
  200|401) exit 0 ;;
  *) echo "unhealthy: ${path} -> ${code}" >&2; exit 1 ;;
esac
