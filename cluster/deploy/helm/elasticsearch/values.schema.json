{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "elasticsearch chart values",
  "type": "object",
  "required": [
    "clusterName",
    "image",
    "nodeGroups"
  ],
  "properties": {
    "clusterName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 40
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "labels": {
      "type": "object"
    },
    "config": {
      "type": "object"
    },
    "clusterBootstrapped": {
      "type": "boolean"
    },
    "nodeGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 30
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "master",
                "voting_only",
                "data",
                "data_content",
                "data_hot",
                "data_warm",
                "data_cold",
                "data_frozen",
                "ingest",
                "ml",
                "remote_cluster_client",
                "transform"
              ]
            }
          },
          "config": {
            "type": "object"
          },
          "resources": {
            "type": "object",
            "properties": {
              "requests": {
                "type": "object"
              },
              "limits": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "persistence": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "size": {
                "type": "string"
              },
              "storageClassName": {
                "type": "string"
              },
              "accessModes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "annotations": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "clientService": {
            "type": "boolean"
          },
          "nodeSelector": {
            "type": "object"
          },
          "tolerations": {
            "type": "array"
          },
          "affinity": {
            "type": "object"
          },
          "antiAffinity": {
            "type": "string",
            "enum": [
              "soft",
              "hard"
            ]
          },
          "antiAffinityTopologyKey": {
            "type": "string"
          },
          "topologySpread": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "maxSkew": {
                "type": "integer",
                "minimum": 1
              },
              "topologyKey": {
                "type": "string"
              },
              "whenUnsatisfiable": {
                "type": "string",
                "enum": [
                  "ScheduleAnyway",
                  "DoNotSchedule"
                ]
              }
            },
            "additionalProperties": false
          },
          "priorityClassName": {
            "type": "string"
          },
          "podAnnotations": {
            "type": "object"
          },
          "podLabels": {
            "type": "object"
          },
          "extraEnv": {
            "type": "array"
          },
          "extraVolumes": {
            "type": "array"
          },
          "extraVolumeMounts": {
            "type": "array"
          },
          "extraInitContainers": {
            "type": "array"
          },
          "extraContainers": {
            "type": "array"
          }
        },
        "additionalProperties": false
      }
    },
    "nodeGroupDefaults": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 30
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "master",
              "voting_only",
              "data",
              "data_content",
              "data_hot",
              "data_warm",
              "data_cold",
              "data_frozen",
              "ingest",
              "ml",
              "remote_cluster_client",
              "transform"
            ]
          }
        },
        "config": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "clientService": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "antiAffinity": {
          "type": "string",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "antiAffinityTopologyKey": {
          "type": "string"
        },
        "topologySpread": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxSkew": {
              "type": "integer",
              "minimum": 1
            },
            "topologyKey": {
              "type": "string"
            },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": [
                "ScheduleAnyway",
                "DoNotSchedule"
              ]
            }
          },
          "additionalProperties": false
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "extraInitContainers": {
          "type": "array"
        },
        "extraContainers": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "podManagementPolicy": {
      "type": "string",
      "enum": [
        "Parallel",
        "OrderedReady"
      ]
    },
    "updateStrategy": {
      "type": "string",
      "enum": [
        "RollingUpdate",
        "OnDelete"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "clusterHealthCheckParams": {
      "type": "string"
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "drainOnShutdown": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allocationDelay": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "masterScaleDown": {
      "type": "object",
      "properties": {
        "votingConfigExclusions": {
          "type": "boolean"
        },
        "cleanupJob": {
          "type": "boolean"
        },
        "cleanupTimeoutSeconds": {
          "type": "integer",
          "minimum": 30
        }
      },
      "additionalProperties": false
    },
    "zoneAwareness": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topologyKey": {
          "type": "string"
        },
        "attribute": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "setAllocationAwareness": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sysctlInitContainer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "vmMaxMapCount": {
          "type": "integer",
          "minimum": 65530
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer"
        },
        "transportPort": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "exporter": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object"
                },
                "limits": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "waitForStatus": {
          "type": "string",
          "enum": [
            "green",
            "yellow"
          ]
        },
        "timeout": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
