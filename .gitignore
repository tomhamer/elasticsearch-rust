/target
**/*.rs.bk
*.pdb
.DS_Store

# Bench artifacts (regenerable)
bench/tools/
bench/indexes/
bench/corpus/corpus.jsonl
bench/corpus/vectors.f32
bench/corpus/queries.jsonl
