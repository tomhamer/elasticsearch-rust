# ES YAML REST suite (downloaded by tests/es-yaml/fetch.sh)
tests/es-yaml/test/
tests/es-yaml/api/
tests/es-yaml/VERSION
tests/es-yaml/v[0-9]*/

# Python bytecode
__pycache__/
*.pyc
